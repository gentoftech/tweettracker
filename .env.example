# TweetTracker Environment Variables Template
# NEVER commit real secret values to .env files inside this repository.
# - Local dev: set secrets in OS environment variables, a local gitignored `.env`, or directly via the `/settings` UI.
# - Production Docker / DigitalOcean: place runtime variables in `/etc/tweettracker/runtime.env` (`chmod 600`) per `docs/DEPLOY_DIGITALOCEAN.md`.

# --- Security & Encrypted In-App Vault ---
# Leave TWEETTRACKER_ADMIN_PASSWORD blank in local dev to unlock UI automatically;
# set a strong password on any cloud / LAN deployment to enable the full-screen password gate.
TWEETTRACKER_ADMIN_PASSWORD=
# Master passphrase (32+ random hex chars) used to encrypt API keys saved in `/settings` (`app_secrets`):
TWEETTRACKER_SECRET_KEY=
TWEETTRACKER_WEBHOOK_SECRET=

# --- Optional Provider Env Fallbacks (can also be pasted directly inside `/settings` UI) ---
TWEETAPI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
GITHUB_TOKEN=

# --- Production Domain, Clean Boot & Postgres (`docker-compose.yml`) ---
SEED_FIXTURES=false
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_USER=tweettracker
POSTGRES_PASSWORD=
POSTGRES_DB=tweettracker

# --- Optional Local SQLite Override ---
DATABASE_URL=
AUTO_MIGRATE=true
